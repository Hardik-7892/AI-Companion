# Copy this file to `.env` and fill in your key (see README -> Claude backend).
# .env is git-ignored, so your key never gets committed.

# OpenRouter API key (starts with sk-or-...). Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: use Anthropic's own API instead of OpenRouter.
# Requires an Anthropic dev account + billing. See model/claude_llm.py.
# ANTHROPIC_API_KEY=
